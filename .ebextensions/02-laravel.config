# Heroku release-phase equivalent. Runs from the staging directory, as root,
# after composer install and BEFORE the predeploy hook that chowns storage/.
# Migrations are opt-in (RUN_MIGRATIONS=true in the environment properties) and
# run on the leader instance only, never before the Heroku database has been
# restored into RDS (the restore drops and recreates the database anyway; docs/TNY-V2-MIGRATION.md §5.3).
# The gate lives INSIDE the command: cfn-init's `test:` key ran the command even
# when the test exited 1 (observed 22 Oct 2026 on another environment).
container_commands:
  00_package_discover:
    # Composer runs with --no-scripts (tny.tf composer_options: the repo's scripts call npm and
    # passport:keys), so Laravel's post-autoload-dump `package:discover` is run here instead.
    command: "php artisan package:discover --ansi --no-interaction"
  01_migrate:
    command: |
      GC=/opt/elasticbeanstalk/bin/get-config
      if [ "$($GC environment -k RUN_MIGRATIONS 2>/dev/null)" = "true" ] && [ "$($GC environment -k APP_ROLE 2>/dev/null)" = "web" ]; then
        php artisan migrate --force --no-interaction
      else
        echo "migrate skipped (RUN_MIGRATIONS=$($GC environment -k RUN_MIGRATIONS 2>/dev/null), APP_ROLE=$($GC environment -k APP_ROLE 2>/dev/null))"
      fi
    leader_only: true
  02_clear_caches:
    # Only CLEAR here. Building the caches must wait for the postdeploy hook: this runs in
    # /var/app/staging and the route/config caches embed absolute paths, so caches built
    # here point at a directory that no longer exists once the app is moved to
    # /var/app/current (broke a deploy on 1 Nov 2026 with a 500 on /up).
    # File caches only — NOT `optimize:clear`, whose cache:clear deletes from the database
    # `cache` table and fails while the schema is empty (first deploy).
    command: "php artisan config:clear --no-interaction && php artisan route:clear --no-interaction && php artisan view:clear --no-interaction && php artisan event:clear --no-interaction"
